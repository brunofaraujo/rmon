# RMonitor (RMon) - variaveis de ambiente
# Copie para .env (dev) ou deixe o instalador gera-lo (prod). O .env real fica com
# permissao 600 e NUNCA e versionado (contem segredos). A propria app le este
# arquivo com Python (nao use EnvironmentFile do systemd - ver deploy/rmon.service).

# Chave para assinar cookies de sessao (gere com: openssl rand -hex 32)
RMON_SECRET_KEY=troque-por-uma-chave-aleatoria

# Login do painel. O hash e gerado pelo instalador/helper (pbkdf2). NAO guarde a senha em texto.
RMON_ADMIN_USER=admin
RMON_ADMIN_PASSWORD_HASH=

# --- Banco de dados: PostgreSQL (obrigatorio) ---
# DSN da conexao. O instalador provisiona o Postgres local e preenche isto.
# Formato: postgresql://usuario:senha@host:porta/banco
RMON_DB_DSN=postgresql://rmon:senha@127.0.0.1:5432/rmon

# --- Credenciais WinRM por PERFIL (multidominio) ---
# O servers.yaml referencia o perfil via 'cred: <nome>'. Um par por dominio/conta.
# Formato de usuario: DOMINIO\usuario  (ou usuario@dominio; conta local: .\usuario)
# Configure com: sudo deploy/definir-winrm.sh <perfil>
RMON_CRED_FIN_USER=
RMON_CRED_FIN_PASSWORD=
RMON_CRED_RH_USER=
RMON_CRED_RH_PASSWORD=

# (Compatibilidade) par unico usado por servidores SEM 'cred' definido:
RMON_WINRM_USER=
RMON_WINRM_PASSWORD=

# --- Estatisticas de jobs do TOTVS RM (opcional) ---
# Login SOMENTE-LEITURA no SQL Server que hospeda a base RM (tabela GJOBXEXECUCAO).
# Configure com: sudo deploy/definir-sql.sh
RMON_SQL_HOST=
RMON_SQL_PORT=1433
RMON_SQL_DB=
RMON_SQL_USER=
RMON_SQL_PASSWORD=

# --- Alertas (opcional) ---
# Telegram: configure com deploy/definir-telegram.sh
RMON_TELEGRAM_TOKEN=
RMON_TELEGRAM_CHAT_ID=
# Slack (Incoming Webhook do canal): configure com deploy/definir-slack.sh
RMON_SLACK_WEBHOOK=

# --- Caminhos e bind ---
RMON_CONFIG=./config/servers.yaml
# Bind do servidor (em producao o systemd usa 0.0.0.0:8080 fixos)
RMON_HOST=127.0.0.1
RMON_PORT=8080
